# ═════════════════════════════════════════════════════════════
# নুরুল কোরআন মাদরাসা — Environment Variables
# ═════════════════════════════════════════════════════════════
# এই ফাইলের কপি নিয়ে .env.local বা .env.production তৈরি করুন
# এবং নিচের মান গুলি নিজের জন্য সেট করুন।

# ─────────────────────────────────────────────────────────────
# ডাটাবেস কনফিগ (MongoDB)
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/nurulquran

# ─────────────────────────────────────────────────────────────
# JWT Secret (লগইন টোকেন সাইন করার জন্য)
# নিচের কমান্ড দিয়ে একটি র্যান্ডম সিক্রেট তৈরি করুন:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your-random-secret-key-here

# ─────────────────────────────────────────────────────────────
# সার্ভার পোর্ট
# ─────────────────────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────────────────────
# অনুমোদিত Origins (CORS) — কমা দ্বারা পৃথক করুন
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yoursite.com

# ─────────────────────────────────────────────────────────────
# Cloudinary ইমেজ আপলোড কনফিগ
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─────────────────────────────────────────────────────────────
# প্রথম সুপার এডমিন তৈরি করা (শুধু প্রথমবার)
# একবার সেট হলে আর কাজ করবে না।
# ─────────────────────────────────────────────────────────────
SEED_SUPERADMIN_UID=admin
SEED_SUPERADMIN_PASSWORD=changeme123
SEED_SUPERADMIN_NAME=সুপার এডমিন
