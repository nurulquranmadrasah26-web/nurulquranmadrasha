<!DOCTYPE html>
<html lang="bn">
<head>
  <link rel="manifest" href="./manifest.json">
  <meta name="theme-color" content="#0b3d24">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="নুরুল কোরআন">
  <link rel="apple-touch-icon" href="./icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
  <link rel="icon" type="image/png" sizes="64x64" href="./icons/favicon.png">

<link rel="preconnect" href="https://nurulquranmadrasha.onrender.com" crossorigin>
<link rel="dns-prefetch" href="https://nurulquranmadrasha.onrender.com">
<script src="config.js"></script>
<script src="nq-warmup.js"></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>নুরুল কোরআন মাদ্রাসা | Teacher Panel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="./nq-font.css">
<style>
  :root{
    --bg:#eef1f5; --card:#ffffff; --text:#1f2430; --muted:#6b7280;
    --line:#e7e9ee; --blue:#2f7dd9; --gold:#e8a83c; --maroon:#a4123f; --green:#1fae64;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Kalpurush','Hind Siliguri','Noto Sans Bengali',sans-serif;
    background:var(--bg); color:var(--text); min-height:100vh; padding-bottom:40px;
  }
  a{text-decoration:none;color:inherit;}
  button{font-family:inherit;cursor:pointer;border:none;}

  header.topbar{
    background:#f7f8fa;border-bottom:1px solid var(--line);
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 22px;flex-wrap:wrap;gap:12px;
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .brand .logo{
    width:50px;height:50px;border-radius:50%;overflow:hidden;
    background:radial-gradient(circle at 30% 30%, #ffe9b8, #d99a1e 70%);
    box-shadow:0 0 0 2px #fff, 0 0 0 3px #d99a1e;
  }
  .brand .names .bn{font-size:15px;font-weight:700;line-height:1.3;}
  .brand .names .en{font-size:13px;color:var(--muted);line-height:1.3;}
  .topbar-right{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .topbar-right .who{font-size:13.5px;font-weight:600;}
  .topbar-right .role{font-size:12px;color:var(--muted);}
  .logout-btn{background:#fdeaea;color:#c81452;padding:8px 14px;border-radius:8px;font-weight:600;}

  /* ===== মেনু (শুধুমাত্র অনুমোদিত ৯টি অপশন) ===== */
  nav.mainnav{
    background:#fff;border-bottom:1px solid var(--line);
    display:flex;gap:8px;padding:10px 16px;overflow-x:auto;
    position:sticky;top:0;z-index:40;box-shadow:0 2px 6px rgba(0,0,0,.04);
  }
  nav.mainnav button{
    background:#f2f4f8;color:#41485a;border:1px solid var(--line);
    padding:9px 15px;border-radius:22px;font-size:14px;font-weight:600;white-space:nowrap;
  }
  nav.mainnav button.active{background:var(--maroon);color:#fff;border-color:var(--maroon);}

  main{max-width:1120px;margin:20px auto;padding:0 16px;}
  .view{display:none;}
  .view.active{display:block;}

  .page-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
  .page-head .icon-box{
    width:44px;height:44px;border-radius:12px;background:var(--gold);
    display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;
  }
  .page-head h1{font-size:19px;margin:0;font-weight:700;}

  .card{background:#fff;border-radius:12px;border:1px solid var(--line);
    box-shadow:0 1px 3px rgba(0,0,0,.04);padding:18px;margin-bottom:18px;}
  .card h2{font-size:16px;margin:0 0 14px;font-weight:700;}

  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
  .field{display:flex;flex-direction:column;gap:6px;margin-bottom:12px;}
  .field label{font-size:13px;color:var(--muted);font-weight:600;}
  .field input,.field select,.field textarea{
    padding:9px 11px;border:1px solid var(--line);border-radius:8px;
    font-family:inherit;font-size:14px;background:#fbfcfe;
  }
  .chk-grid{display:flex;flex-wrap:wrap;gap:10px;}
  .chk-grid label{display:flex;align-items:center;gap:6px;font-size:13.5px;
    background:#f5f7fa;border:1px solid var(--line);padding:6px 10px;border-radius:8px;}

  .btn{background:var(--green);color:#fff;padding:11px 20px;border-radius:9px;font-weight:700;font-size:14.5px;}
  .btn.blue{background:var(--blue);} .btn.gray{background:#78909c;} .btn.red{background:#c81452;}
  .btn-bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;}

  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  th,td{padding:9px 8px;border-bottom:1px solid var(--line);text-align:left;}
  th{background:#f6f8fb;font-weight:700;color:#44506a;}
  .empty-row{text-align:center;color:#999;padding:18px 0;}
  .table-wrap{overflow-x:auto;}

  .tabbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
  .tabbtn{background:#fff;border:1px solid var(--line);padding:8px 14px;border-radius:8px;font-size:13.5px;font-weight:600;}
  .tabbtn.active{background:var(--blue);color:#fff;border-color:var(--blue);}

  .save-bar{background:var(--green);color:#fff;padding:13px;border-radius:10px;text-align:center;
    font-weight:700;margin-top:14px;cursor:pointer;}
  .save-bar small{display:block;font-weight:500;opacity:.9;font-size:12.5px;margin-top:3px;}
  .sum-line{display:flex;justify-content:space-between;padding:9px 2px;border-bottom:1px dashed var(--line);font-size:14px;}
  .sum-line strong{font-weight:700;}
  .pill{padding:3px 9px;border-radius:20px;font-size:12px;font-weight:700;}
  .pill.green{background:#e6f7ee;color:#12784a;} .pill.red{background:#fdeaea;color:#c81452;}

  @media(max-width:760px){ .grid2,.grid3{grid-template-columns:1fr;} }
</style>
<script src="auth.js"></script>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="logo"><img src="./assets/app-logo.png" alt="লোগো" style="width:100%;height:100%;object-fit:contain;border-radius:inherit;"></div>
    <div class="names">
      <div class="bn">নুরুল কোরআন মাদ্রাসা</div>
      <div class="en">শিক্ষক প্যানেল</div>
    </div>
  </div>
  <div class="topbar-right">
    <span class="who" data-user-name>—</span>
    <span class="role" data-user-role></span>
    <button class="logout-btn" data-logout>লগআউট</button>
  </div>
</header>

<!-- ===== শিক্ষকের আইডিতে শুধুমাত্র এই ৯টি অপশন থাকবে ===== -->
<nav class="mainnav" id="teacherNav">
  <button data-view="admission" onclick="goto('admission')">ভর্তি</button>
  <button data-view="attendance" onclick="goto('attendance')">হাজিরা</button>
  <button data-view="adai" onclick="goto('adai')">আদায়</button>
  <button data-view="inventory" onclick="goto('inventory')">ইনভেন্টরি</button>
  <button data-view="homework" onclick="goto('homework')">পড়া দেওয়া</button>
  <button data-view="attnotice" onclick="goto('attnotice')">ক্লাস হাজিরার নোটিশ</button>
  <button data-view="subject" onclick="goto('subject')">বিষয়</button>
  <button data-view="examsubject" onclick="goto('examsubject')">পরিক্ষার বিষয়</button>
  <button data-view="fee" onclick="goto('fee')">ফি আদায়</button>
</nav>

<main>

  <!-- ============ ১. ভর্তি ============ -->
  <section id="view-admission" class="view">
    <div class="page-head"><div class="icon-box">＋</div><h1>ভর্তি</h1></div>
    <div class="card">
      <h2>নতুন শিক্ষার্থী ভর্তি</h2>
      <div class="grid3">
        <div class="field"><label>শিক্ষার্থীর নাম *</label><input id="admName" placeholder="নাম লিখুন"></div>
        <div class="field"><label>শ্রেণী *</label><select id="admClass"></select></div>
        <div class="field"><label>অভিভাবকের নাম</label><input id="admParent" placeholder="পিতা/মাতার নাম"></div>
        <div class="field"><label>মোবাইল নম্বর</label><input id="admMobile" placeholder="01XXXXXXXXX"></div>
        <div class="field"><label>মাসিক ফি</label><input type="number" id="admFee" value="0"></div>
        <div class="field"><label>ভর্তি বাবদ বকেয়া</label><input type="number" id="admDue" value="0"></div>
      </div>
      <div class="btn-bar"><button class="btn" onclick="saveAdmission()">✓ ভর্তি সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>ভর্তিকৃত শিক্ষার্থীর তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>রেজিঃ নং</th><th>নাম</th><th>শ্রেণী</th><th>অভিভাবক</th><th>মোবাইল</th><th>মাসিক ফি</th></tr></thead>
          <tbody id="admBody"><tr><td colspan="7" class="empty-row">লোড হচ্ছে...</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ২. হাজিরা ============ -->
  <section id="view-attendance" class="view">
    <div class="page-head"><div class="icon-box">✅</div><h1>শিক্ষার্থীর হাজিরা</h1></div>
    
    <!-- ───── ২.১ হাজিরা গ্রহণ ───── -->
    <div class="card">
      <h2>হাজিরা গ্রহণ</h2>
      <div class="grid2">
        <div class="field"><label>শ্রেণী নির্বাচন</label><select id="hazFilterClass" onchange="renderHajira()"></select></div>
        <div class="field"><label>বিভাগ</label><select id="hazFilterDept" onchange="renderHajira()">
          <option value="">সকল বিভাগ</option>
          <option>বালিকা</option><option>নুরানি</option><option>বালক</option>
        </select></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>রেজিঃ নং</th><th>ক্লাস রোল</th><th>নাম</th><th>শ্রেণী</th><th>বিভাগ</th><th>হাজিরা</th></tr></thead>
          <tbody id="hazTableBody"><tr><td colspan="7" class="empty-row">লোড হচ্ছে...</td></tr></tbody>
        </table>
      </div>
      <div class="save-bar" onclick="saveHajira()">✓ সংরক্ষণ করুন
        <small id="hazSummary">মোট : ০ উপস্থিত – ০ অনুপস্থিত – ০ ছুটিতে</small>
      </div>
    </div>

    <!-- ───── ২.২ হাজিরার তালিকা ───── -->
    <div class="card">
      <h2>হাজিরার তালিকা ও ইতিহাস</h2>
      <div class="grid3">
        <div class="field"><label>নাম</label><input type="text" id="hzlName" placeholder="নাম" oninput="renderHazList()"></div>
        <div class="field"><label>রেজি: নং</label><input type="text" id="hzlReg" placeholder="রেজি: নং" oninput="renderHazList()"></div>
        <div class="field"><label>শ্রেণী</label><select id="hzlClass" onchange="renderHazList()"><option value="">সকল শ্রেণী</option></select></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>রেজি: নং</th><th>ক্লাস রোল</th><th>নাম</th><th>শ্রেণী</th><th>বিভাগ</th><th>হাজিরা সারাংশ</th></tr></thead>
          <tbody id="hazListTableBody"><tr><td colspan="7" class="empty-row">লোড হচ্ছে...</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- ───── ২.३ ছুটির আবেদন ───── -->
    <div class="card">
      <h2>ছুটির আবেদন</h2>
      <div class="grid3">
        <div class="field"><label>শিক্ষার্থী নির্বাচন</label><select id="lvStudent" onchange="renderLeaveApply()"><option value="">-</option></select></div>
        <div class="field"><label>কারণ</label><select id="lvReason">
          <option value="">-</option>
          <option>অসুস্থতা</option><option>পারিবারিক কারণ</option><option>ব্যক্তিগত কারণ</option>
          <option>জরুরি প্রয়োজন</option><option>অন্যান্য</option>
        </select></div>
        <div class="field"><label>তারিখ</label><input type="date" id="lvFrom" onchange="updateLeavedays()"></div>
      </div>
      <div class="grid2">
        <div class="field"><label>শেষ তারিখ</label><input type="date" id="lvTo" onchange="updateLeavedays()"></div>
        <div class="field"><label>মোট দিন</label><input type="number" id="lvDays" value="0" disabled></div>
      </div>
      <div class="field"><label>বিস্তারিত কারণ</label><textarea id="lvDetail" rows="3" placeholder="বিস্তারিত লিখুন"></textarea></div>
      <div class="btn-bar"><button class="btn" onclick="submitLeaveApply()">✓ আবেদন জমা দিন</button></div>
    </div>

    <!-- ───── ২.४ ছুটির অনুরোধ তালিকা ───── -->
    <div class="card">
      <h2>সকল ছুটির অনুরোধ</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>নাম</th><th>কারণ</th><th>থেকে</th><th>পর্যন্ত</th><th>দিন</th><th>অবস্থা</th></tr></thead>
          <tbody id="leaveApplyTableBody"><tr><td colspan="7" class="empty-row">কোনো অনুরোধ নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৩. আদায় ============ -->
  <section id="view-adai" class="view">
    <div class="page-head"><div class="icon-box">💵</div><h1>আদায়</h1></div>
    <div class="card">
      <h2>নতুন আদায় এন্ট্রি</h2>
      <div class="grid3">
        <div class="field"><label>আদায়ের খাত *</label><input id="adSource" placeholder="যেমন: বই বিক্রয়, অনুদান"></div>
        <div class="field"><label>যার কাছ থেকে</label><input id="adParty" placeholder="নাম"></div>
        <div class="field"><label>টাকার পরিমাণ *</label><input type="number" id="adAmount" placeholder="0"></div>
        <div class="field"><label>পদ্ধতি</label>
          <select id="adMethod"><option>নগদ</option><option>বিকাশ</option><option>ব্যাংক</option></select>
        </div>
        <div class="field"><label>তারিখ</label><input type="date" id="adDate"></div>
        <div class="field"><label>মন্তব্য</label><input id="adNote" placeholder="মন্তব্য"></div>
      </div>
      <div class="btn-bar"><button class="btn" onclick="saveAdai()">✓ আদায় সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>আদায়ের তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>তারিখ</th><th>খাত</th><th>নাম</th><th>পদ্ধতি</th><th>টাকা</th><th>আদায়কারী</th></tr></thead>
          <tbody id="adBody"><tr><td colspan="7" class="empty-row">লোড হচ্ছে...</td></tr></tbody>
        </table>
      </div>
      <div class="sum-line"><span>মোট আদায়</span><strong id="adTotal">0.00 টাকা</strong></div>
    </div>
  </section>

  <!-- ============ ৪. ইনভেন্টরি ============ -->
  <section id="view-inventory" class="view">
    <div class="page-head"><div class="icon-box">📦</div><h1>ইনভেন্টরি</h1></div>
    <div class="card">
      <h2>পণ্য বিক্রয় / বিতরণ</h2>
      <div class="grid3">
        <div class="field"><label>পণ্য *</label><select id="invProduct" onchange="invFillPrice()"></select></div>
        <div class="field"><label>পরিমাণ *</label><input type="number" id="invQty" value="1" oninput="invCalc()"></div>
        <div class="field"><label>একক মূল্য</label><input type="number" id="invPrice" value="0" oninput="invCalc()"></div>
        <div class="field"><label>গ্রাহক / শিক্ষার্থী</label><input id="invCustomer" placeholder="নাম"></div>
        <div class="field"><label>পরিশোধ</label><input type="number" id="invPaid" value="0" oninput="invCalc()"></div>
        <div class="field"><label>মোট</label><input id="invTotal" value="0" disabled></div>
      </div>
      <div class="btn-bar"><button class="btn" onclick="saveInvSale()">✓ বিক্রয় সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>স্টক তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>পণ্য</th><th>ধরন</th><th>একক</th><th>বিক্রয় মূল্য</th><th>স্টক</th></tr></thead>
          <tbody id="invStockBody"><tr><td colspan="6" class="empty-row">লোড হচ্ছে...</td></tr></tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <h2>সাম্প্রতিক বিক্রয়</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>তারিখ</th><th>গ্রাহক</th><th>মোট</th><th>পরিশোধ</th><th>বাকি</th></tr></thead>
          <tbody id="invSaleBody"><tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৫. পড়া দেওয়া ============ -->
  <section id="view-homework" class="view">
    <div class="page-head"><div class="icon-box">📖</div><h1>পড়া দেওয়া</h1></div>
    <div class="card">
      <h2>নতুন পড়া</h2>
      <div class="grid3">
        <div class="field"><label>শ্রেণী *</label><select id="hwClass" onchange="fillHwSubjects()"></select></div>
        <div class="field"><label>বিষয় *</label><select id="hwSubject"></select></div>
        <div class="field"><label>তারিখ *</label><input type="date" id="hwDate"></div>
      </div>
      <div class="field"><label>পড়ার বিবরণ *</label><textarea id="hwTask" rows="3" placeholder="আজকের পড়া লিখুন"></textarea></div>
      <div class="chk-grid" style="margin-bottom:12px;"><label><input type="checkbox" id="hwKhata"> খাতায় লিখতে হবে</label></div>
      <div class="btn-bar"><button class="btn" onclick="saveHomework()">✓ পড়া সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>পড়ার তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>শ্রেণী</th><th>বিষয়</th><th>বিবরণ</th><th>তারিখ</th><th>শিক্ষক</th><th>অপারেশন</th></tr></thead>
          <tbody id="hwBody"><tr><td colspan="7" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৬. ক্লাস হাজিরার নোটিশ ============ -->
  <section id="view-attnotice" class="view">
    <div class="page-head"><div class="icon-box">🔔</div><h1>ক্লাস হাজিরার নোটিশ</h1></div>
    <div class="card">
      <h2>নতুন নোটিশ</h2>
      <div class="grid2">
        <div class="field"><label>শিরোনাম *</label><input id="anTitle" placeholder="যেমন: অনুপস্থিতির নোটিশ"></div>
        <div class="field"><label>তারিখ</label><input type="date" id="anDate"></div>
      </div>
      <div class="field"><label>বিবরণ *</label><textarea id="anDesc" rows="3" placeholder="নোটিশের বিবরণ"></textarea></div>
      <div class="field"><label>শ্রেণী নির্বাচন</label><div class="chk-grid" id="anClassGrid"></div></div>
      <div class="btn-bar"><button class="btn" onclick="saveAttNotice()">✓ নোটিশ প্রকাশ করুন</button></div>
    </div>
    <div class="card">
      <h2>নোটিশের তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>শিরোনাম</th><th>বিবরণ</th><th>শ্রেণী</th><th>তারিখ</th><th>অপারেশন</th></tr></thead>
          <tbody id="anBody"><tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৭. বিষয় ============ -->
  <section id="view-subject" class="view">
    <div class="page-head"><div class="icon-box">📚</div><h1>বিষয়</h1></div>
    <div class="card">
      <h2>নতুন বিষয়</h2>
      <div class="grid2">
        <div class="field"><label>বিষয়ের নাম *</label><input id="sbName" placeholder="বিষয়ের নাম"></div>
        <div class="field"><label>শ্রেণী নির্বাচন</label><div class="chk-grid" id="sbClassGrid"></div></div>
      </div>
      <div class="btn-bar"><button class="btn" onclick="saveSubject()">✓ সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>বিষয়ের তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>বিষয়</th><th>শ্রেণী</th><th>অপারেশন</th></tr></thead>
          <tbody id="sbBody"><tr><td colspan="4" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৮. পরিক্ষার বিষয় ============ -->
  <section id="view-examsubject" class="view">
    <div class="page-head"><div class="icon-box">📝</div><h1>পরিক্ষার বিষয়</h1></div>
    <div class="card">
      <h2>নতুন পরিক্ষার বিষয়</h2>
      <div class="grid2">
        <div class="field"><label>বিষয়ের নাম *</label><input id="esName" placeholder="বিষয়ের নাম"></div>
        <div class="field"><label>শ্রেণী নির্বাচন</label><div class="chk-grid" id="esClassGrid"></div></div>
      </div>
      <div class="btn-bar"><button class="btn" onclick="saveExamSubject()">✓ সংরক্ষণ করুন</button></div>
    </div>
    <div class="card">
      <h2>পরিক্ষার বিষয়ের তালিকা</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>বিষয়</th><th>শ্রেণী</th><th>অপারেশন</th></tr></thead>
          <tbody id="esBody"><tr><td colspan="4" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ ৯. ফি আদায় ============ -->
  <section id="view-fee" class="view">
    <div class="page-head"><div class="icon-box">💰</div><h1>ফি আদায়</h1></div>
    <div class="card">
      <div class="grid3">
        <div class="field"><label>শিক্ষার্থী *</label><select id="feeStudent" onchange="renderFeeDues()"></select></div>
        <div class="field"><label>পরিশোধের পদ্ধতি</label>
          <select id="feeMethod"><option>নগদ</option><option>বিকাশ</option><option>ব্যাংক</option></select>
        </div>
        <div class="field"><label>আদায়কারীর নাম</label><input id="feeCollector" data-user-name disabled></div>
      </div>
      <div class="grid2">
        <div>
          <h2>বকেয়ার তালিকা</h2>
          <div id="feeDueList"><div class="empty-row">শিক্ষার্থী নির্বাচন করুন</div></div>
        </div>
        <div>
          <h2>হিসাব</h2>
          <div class="sum-line"><span>মোট বকেয়া</span><strong id="feeTotalDue">0.00</strong></div>
          <div class="sum-line"><span>মোট নির্বাচিত</span><strong id="feeSelected">0.00 টাকা</strong></div>
          <div class="sum-line"><span>ডিসকাউন্ট</span><input type="number" id="feeDiscount" value="0" oninput="updateFeeSummary()" style="width:110px;border:1px solid var(--line);border-radius:6px;padding:5px 7px;"></div>
          <div class="sum-line"><span>পরিশোধ</span><input type="number" id="feePaid" value="0" oninput="updateFeeSummary()" style="width:110px;border:1px solid var(--line);border-radius:6px;padding:5px 7px;"></div>
          <div class="sum-line"><span>বাকি টাকা</span><strong id="feeRemaining">0.00 টাকা</strong></div>
          <div class="field" style="margin-top:12px;"><label>মন্তব্য</label><input id="feeRemark" placeholder="মন্তব্য"></div>
          <div class="save-bar" onclick="saveFeeCollection()">✓ সংরক্ষণ করুন</div>
        </div>
      </div>
    </div>
    <div class="card">
      <h2>সাম্প্রতিক ফি আদায়</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>শিক্ষার্থী</th><th>টাকা</th><th>মাস</th><th>তারিখ</th><th>আদায়কারী</th></tr></thead>
          <tbody id="feePayBody"><tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<script>
/* ══════════════════════════════════════════════════════════════════
   শিক্ষক প্যানেল — এডমিন প্যানেলের একই ডেটা স্টোরের (/api/store) সাথে যুক্ত।
   শিক্ষকের আইডিতে শুধুমাত্র নিচের ৯টি অপশন থাকবে (এর বাইরে কিছু নয়):
   ভর্তি, হাজিরা, আদায়, ইনভেন্টরি, পড়া দেওয়া, ক্লাস হাজিরার নোটিশ,
   বিষয়, পরিক্ষার বিষয়, ফি আদায়।
   ══════════════════════════════════════════════════════════════════ */
var S = {};                 // সার্ভার স্টোর
var attActiveClass = '';
var attTempt = {};
var feeSelected = {};
var attendance = {};        // বর্তমান হাজিরা রেকর্ড
var leaveRequests = [];     // ছুটির অনুরোধ

function bn(n){ return String(n == null ? '' : n).replace(/[০-৯]/g, function(d){ return String('০১২৩৪৫৬৭৮৯'.indexOf(d)); }); }
function esc(t){ return String(t == null ? '' : t).replace(/[&<>"]/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); }
function todayISO(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function bnDate(iso){ if(!iso) return ''; var p=String(iso).split('-'); return p.length===3 ? bn(p[2]+'/'+p[1]+'/'+p[0]) : String(iso); }
function arr(v){ return Array.isArray(v) ? v : []; }
function obj(v){ return (v && typeof v === 'object' && !Array.isArray(v)) ? v : {}; }
function me(){ return (window.NQAuth && window.NQAuth.user) || {}; }
function userName(){ return me().name || me().uid || 'শিক্ষক'; }
function nextId(list){ return arr(list).length ? Math.max.apply(null, arr(list).map(function(x){ return Number(x.id)||0; })) + 1 : 1; }
function monthLabel(){
  var m=['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
  var d=new Date(); return m[d.getMonth()] + ' ' + d.getFullYear();
}
function toast(msg){
  var el = document.getElementById('nqToast');
  if(!el){ el=document.createElement('div'); el.id='nqToast';
    el.style.cssText='position:fixed;bottom:26px;left:50%;transform:translateX(-50%);background:#1f2430;color:#fff;padding:12px 20px;border-radius:8px;z-index:9999;font-size:14px;box-shadow:0 6px 18px rgba(0,0,0,.2);display:none;';
    document.body.appendChild(el); }
  el.textContent=msg; el.style.display='block';
  clearTimeout(el._t); el._t=setTimeout(function(){ el.style.display='none'; }, 2600);
}
function classList(){
  var set = {};
  arr(S.students).forEach(function(st){ if(st.cls) set[st.cls]=1; });
  arr(S.otClasses).forEach(function(c){ if(c && c.name) set[c.name]=1; });
  var out = Object.keys(set);
  return out.length ? out : ['নার্সারী'];
}
function fillClassSelect(id){
  var sel = document.getElementById(id); if(!sel) return;
  var cur = sel.value;
  sel.innerHTML = classList().map(function(c){ return '<option>' + esc(c) + '</option>'; }).join('');
  if(cur) sel.value = cur;
}
function fillClassChecks(id, cssClass){
  var box = document.getElementById(id); if(!box) return;
  box.innerHTML = classList().map(function(c){
    return '<label><input type="checkbox" class="' + cssClass + '" value="' + esc(c) + '"> ' + esc(c) + '</label>';
  }).join('');
}
function checkedValues(cssClass){
  return Array.prototype.slice.call(document.querySelectorAll('.' + cssClass + ':checked')).map(function(c){ return c.value; });
}

/* ---------- নেভিগেশন ---------- */
function goto(name){
  document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
  var target = document.getElementById('view-' + name);
  if(target) target.classList.add('active');
  document.querySelectorAll('#teacherNav button').forEach(function(b){ b.classList.remove('active'); });
  var nav = document.querySelector('#teacherNav button[data-view="' + name + '"]');
  if(nav) nav.classList.add('active');
  try { localStorage.setItem('nq_teacher_view', name); } catch(e){}
  if(name === 'admission'){ fillClassSelect('admClass'); renderAdmissionList(); }
  if(name === 'attendance'){ renderHajira(); renderHazList(); ensureLeaveStudentOptions(); renderLeaveApply(); }
  if(name === 'adai') renderAdaiList();
  if(name === 'inventory'){ invFillProducts(); renderInvStock(); renderInvSales(); }
  if(name === 'homework'){ fillClassSelect('hwClass'); fillHwSubjects(); renderHomework(); }
  if(name === 'attnotice'){ fillClassChecks('anClassGrid','anClassChk'); renderAttNotices(); }
  if(name === 'subject'){ fillClassChecks('sbClassGrid','sbClassChk'); renderSubjects(); }
  if(name === 'examsubject'){ fillClassChecks('esClassGrid','esClassChk'); renderExamSubjects(); }
  if(name === 'fee'){ renderFeeStudents(); renderFeePayments(); }
  window.scrollTo({top:0, behavior:'smooth'});
}

/* ---------- ডেটা সেভ ---------- */
function saveKeys(keys){
  return window.NQAuth.saveStore(keys).then(function(){ Object.assign(S, keys); })
    .catch(function(e){ console.error(e); toast('সংরক্ষণ ব্যর্থ: ' + e.message); throw e; });
}

/* ---------- বুট ---------- */
function boot(){
  if(!window.NQAuth || !window.NQAuth.isLoggedIn()) return;
  document.getElementById('adDate').value = todayISO();
  document.getElementById('hwDate').value = todayISO();
  document.getElementById('anDate').value = todayISO();

  window.NQAuth.loadStore().then(function(data){
    S = data || {};
    attendance = obj(S.attendance) || {};
    leaveRequests = arr(S.leaveRequests) || [];
    var last = 'admission';
    try { last = localStorage.getItem('nq_teacher_view') || 'admission'; } catch(e){}
    if(!document.getElementById('view-' + last)) last = 'admission';
    goto(last);
  }).catch(function(){ goto('admission'); });
}

/* ══════════ ১. ভর্তি ══════════ */
function renderAdmissionList(){
  var students = arr(S.students).slice().reverse();
  document.getElementById('admBody').innerHTML = students.length ? students.map(function(st, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + bn(st.regNo || st.id) + '</td><td>' + esc(st.name) + '</td><td>' + esc(st.cls || '-') +
      '</td><td>' + esc(st.parent || '-') + '</td><td>' + esc(st.mobile || '-') + '</td><td>' + bn(st.fee || 0) + '</td></tr>';
  }).join('') : '<tr><td colspan="7" class="empty-row">কোনো শিক্ষার্থী নেই</td></tr>';
}
function saveAdmission(){
  var name = document.getElementById('admName').value.trim();
  var cls = document.getElementById('admClass').value;
  if(!name || !cls){ toast('নাম ও শ্রেণী আবশ্যক'); return; }
  var students = arr(S.students).slice();
  var id = nextId(students);
  var fee = Number(document.getElementById('admFee').value) || 0;
  var due = Number(document.getElementById('admDue').value) || 0;
  students.push({
    id: id, regNo: id, name: name, cls: cls, attCls: cls,
    parent: document.getElementById('admParent').value.trim(),
    mobile: document.getElementById('admMobile').value.trim(),
    fee: fee, admission: bnDate(todayISO()), status: 'সক্রিয়'
  });
  var attendance = obj(S.attendance); attendance[id] = 'present';
  var dues = obj(S.studentDues);
  dues[id] = due > 0 ? [{ id: Date.now(), label: 'ভর্তি বাবদ বকেয়া', amount: due, month: monthLabel() }] : [];

  saveKeys({ students: students, attendance: attendance, studentDues: dues }).then(function(){
    toast('ভর্তি সংরক্ষণ করা হয়েছে!');
    ['admName','admParent','admMobile'].forEach(function(x){ document.getElementById(x).value=''; });
    document.getElementById('admFee').value = 0;
    document.getElementById('admDue').value = 0;
    renderAdmissionList();
  });
}

/* ══════════ ২. হাজিরা ══════════ */
/* ══════════ ২.१ হাজিরা গ্রহণ (Attendance Taking) ══════════ */
function initHajiraData() {
  arr(S.students).forEach(function(s, idx) {
    if (!s.regNo) s.regNo = idx + 1;
    if (!s.classRoll) s.classRoll = (idx % 12) + 1;
    if (!s.attCls) s.attCls = classList()[idx % classList().length];
    if (!s.attDept) s.attDept = ['বালিকা','নুরানি','বালক'][idx % 3];
  });
  var sel = document.getElementById('hazFilterClass');
  if (sel && sel.options.length <= 1) {
    classList().forEach(function(c) {
      var o = document.createElement('option');
      o.textContent = c;
      sel.appendChild(o);
    });
  }
}

function renderHajira(){
  initHajiraData();
  var clsF = document.getElementById('hazFilterClass').value;
  var deptF = document.getElementById('hazFilterDept').value;
  var rows = arr(S.students).filter(function(s) { 
    return (!clsF || s.attCls === clsF) && (!deptF || s.attDept === deptF); 
  });
  document.getElementById('hazTableBody').innerHTML = rows.map(function(s,i){
    var status = attendance[s.id] || 'present';
    return '<tr><td>' + bn(i+1) + '</td><td>' + bn(s.regNo || s.id) + '</td><td>' + bn(s.classRoll || i+1) + '</td>' +
      '<td>' + esc(s.name) + '</td><td>' + esc(s.attCls || '') + '</td><td>' + esc(s.attDept || '') + '</td>' +
      '<td><div style="display:flex;gap:8px;font-size:12px;">' +
      '<label style="color:#2e7d32;cursor:pointer;"><input type="radio" name="haz-' + s.id + '" ' + (status==='present'?'checked':'') + 
      ' onchange="attendance[' + s.id + ']=' + "'present'" + '; updateHajiraSummary();"> উপস্থিত</label>' +
      '<label style="color:#c62828;cursor:pointer;"><input type="radio" name="haz-' + s.id + '" ' + (status==='absent'?'checked':'') + 
      ' onchange="attendance[' + s.id + ']=' + "'absent'" + '; updateHajiraSummary();"> অনুপস্থিত</label>' +
      '<label style="color:#1565c0;cursor:pointer;"><input type="radio" name="haz-' + s.id + '" ' + (status==='leave'?'checked':'') + 
      ' onchange="attendance[' + s.id + ']=' + "'leave'" + '; updateHajiraSummary();"> ছুটিতে</label></div></td></tr>';
  }).join('');
  updateHajiraSummary();
}

function updateHajiraSummary(){
  var p = Object.keys(attendance).filter(function(k){ return attendance[k] === 'present'; }).length;
  var a = Object.keys(attendance).filter(function(k){ return attendance[k] === 'absent'; }).length;
  var l = Object.keys(attendance).filter(function(k){ return attendance[k] === 'leave'; }).length;
  var el = document.getElementById('hazSummary');
  if (el) el.textContent = 'মোট : ' + bn(p) + ' উপস্থিত – ' + bn(a) + ' অনুপস্থিত – ' + bn(l) + ' ছুটিতে';
}

function saveHajira(){
  updateHajiraSummary();
  var att = obj(S.attendance) || {};
  Object.keys(attendance).forEach(function(k){ att[k] = attendance[k]; });
  saveKeys({ attendance: att }).then(function(){ 
    toast('হাজিরা সফলভাবে সংরক্ষিত হয়েছে!');
  });
}

/* ══════════ २.२ হাজিরার তালিকা (Attendance List) ══════════ */
function initHazListData() {
  initHajiraData();
  arr(S.students).forEach(function(s) {
    if (s.attTotals) return;
    var seeded = function(seed) { var x = Math.sin(seed * 999) * 10000; return x - Math.floor(x); };
    var present = 60 + Math.floor(seeded(s.id) * 70);
    var absent = Math.floor(seeded(s.id + 50) * 20);
    var leave = Math.floor(seeded(s.id + 90) * 9);
    s.attTotals = { present: present, absent: absent, leave: leave };
  });
  var sel = document.getElementById('hzlClass');
  if (sel && sel.options.length <= 1) {
    classList().forEach(function(c) {
      var o = document.createElement('option');
      o.textContent = c;
      sel.appendChild(o);
    });
  }
}

function renderHazList(){
  initHazListData();
  var name = document.getElementById('hzlName').value.trim();
  var reg = document.getElementById('hzlReg').value.trim();
  var cls = document.getElementById('hzlClass').value;
  
  var rows = arr(S.students).filter(function(s) {
    return (!name || s.name.indexOf(name) !== -1) &&
           (!reg  || String(s.regNo).indexOf(reg) !== -1) &&
           (!cls  || s.attCls === cls);
  });
  
  document.getElementById('hazListTableBody').innerHTML = rows.map(function(s, i){
    var atts = s.attTotals || { present: 0, absent: 0, leave: 0 };
    return '<tr><td>' + bn(i+1) + '</td><td>' + bn(s.regNo || s.id) + '</td><td>' + bn(s.classRoll || i+1) + '</td>' +
      '<td>' + esc(s.name) + '</td><td>' + esc(s.attCls || '') + '</td><td>' + esc(s.attDept || '') + '</td>' +
      '<td><span style="color:#2e7d32;">' + bn(atts.present) + '</span> উপস্থিত &nbsp;|&nbsp; ' +
      '<span style="color:#c62828;">' + bn(atts.absent) + '</span> অনুপস্থিত &nbsp;|&nbsp; ' +
      '<span style="color:#1565c0;">' + bn(atts.leave) + '</span> ছুটিতে</td></tr>';
  }).join('') || '<tr><td colspan="7" class="empty-row">কোনো তথ্য নেই</td></tr>';
}

/* ══════════ २.३ ছুটির আবেদন (Leave Application) ══════════ */
function ensureLeaveStudentOptions() {
  var sel = document.getElementById('lvStudent');
  if (sel && sel.options.length <= 1) {
    initHajiraData();
    arr(S.students).forEach(function(s) {
      var o = document.createElement('option');
      o.value = s.id;
      o.textContent = bn(s.regNo || s.id) + ' - ' + s.name;
      sel.appendChild(o);
    });
  }
}

function updateLeavedays(){
  var from = document.getElementById('lvFrom').value;
  var to = document.getElementById('lvTo').value;
  if (!from || !to) { document.getElementById('lvDays').value = '0'; return; }
  var d1 = new Date(from);
  var d2 = new Date(to);
  var diff = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
  document.getElementById('lvDays').value = Math.max(1, diff);
}

function submitLeaveApply(){
  var id = parseInt(document.getElementById('lvStudent').value) || 0;
  var reason = document.getElementById('lvReason').value;
  var from = document.getElementById('lvFrom').value;
  var to = document.getElementById('lvTo').value;
  var detail = document.getElementById('lvDetail').value;
  
  if (!id || !reason || !from || !to) { toast('সকল তথ্য পূরণ করুন'); return; }
  
  var student = arr(S.students).find(function(s){ return s.id === id; });
  if (!student) { toast('শিক্ষার্থী নির্বাচন করুন'); return; }
  
  var d1 = new Date(from);
  var d2 = new Date(to);
  var days = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
  
  if (!leaveRequests) leaveRequests = [];
  leaveRequests.push({
    id: leaveRequests.length + 1,
    name: student.name,
    studentId: id,
    reason: reason,
    from: from,
    to: to,
    days: Math.max(1, days),
    detail: detail || '',
    status: 'অপেক্ষমান',
    rejectReason: '',
    date: todayISO()
  });
  
  saveKeys({ leaveRequests: leaveRequests }).then(function(){
    toast('আপনার ছুটির আবেদন জমা হয়েছে');
    document.getElementById('lvStudent').value = '';
    document.getElementById('lvReason').value = '';
    document.getElementById('lvFrom').value = '';
    document.getElementById('lvTo').value = '';
    document.getElementById('lvDetail').value = '';
    document.getElementById('lvDays').value = '0';
    renderLeaveApply();
  });
}

function renderLeaveApply(){
  ensureLeaveStudentOptions();
  if (!leaveRequests || !leaveRequests.length) {
    document.getElementById('leaveApplyTableBody').innerHTML = '<tr><td colspan="7" class="empty-row">কোনো অনুরোধ নেই</td></tr>';
    return;
  }
  document.getElementById('leaveApplyTableBody').innerHTML = arr(leaveRequests).map(function(r, i){
    var statusColor = r.status === 'অনুমোদিত' ? '#2e7d32' : r.status === 'প্রত্যাখ্যাত' ? '#c62828' : '#f57c00';
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(r.name) + '</td><td>' + esc(r.reason) + '</td>' +
      '<td>' + r.from + '</td><td>' + r.to + '</td><td>' + bn(r.days) + '</td>' +
      '<td style="color:' + statusColor + '">' + esc(r.status) + '</td></tr>';
  }).join('');
}

/* ══════════ ৩. আদায় ══════════ */
function renderAdaiList(){
  var tx = arr(S.financeTx).filter(function(t){ return t.type === 'income'; });
  document.getElementById('adBody').innerHTML = tx.length ? tx.slice(0, 50).map(function(t, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(t.date || '') + '</td><td>' + esc(t.desc || '') + '</td><td>' + esc(t.name || '-') +
      '</td><td>' + esc(t.method || '-') + '</td><td>' + bn(t.amount || 0) + '</td><td>' + esc(t.by || '-') + '</td></tr>';
  }).join('') : '<tr><td colspan="7" class="empty-row">কোনো তথ্য নেই</td></tr>';
  var total = tx.reduce(function(s,t){ return s + (Number(t.amount)||0); }, 0);
  document.getElementById('adTotal').textContent = total.toFixed(2) + ' টাকা';
}
function saveAdai(){
  var source = document.getElementById('adSource').value.trim();
  var amount = Number(document.getElementById('adAmount').value) || 0;
  if(!source || amount <= 0){ toast('আদায়ের খাত ও টাকার পরিমাণ আবশ্যক'); return; }
  var tx = arr(S.financeTx).slice();
  tx.unshift({
    id: nextId(tx), date: document.getElementById('adDate').value || todayISO(),
    name: document.getElementById('adParty').value.trim() || '-',
    desc: source, type: 'income', amount: amount, by: userName(),
    method: document.getElementById('adMethod').value,
    note: document.getElementById('adNote').value.trim()
  });
  saveKeys({ financeTx: tx }).then(function(){
    toast('আদায় সংরক্ষণ করা হয়েছে!');
    ['adSource','adParty','adAmount','adNote'].forEach(function(x){ document.getElementById(x).value=''; });
    renderAdaiList();
  });
}

/* ══════════ ৪. ইনভেন্টরি ══════════ */
function invFillProducts(){
  var sel = document.getElementById('invProduct');
  var products = arr(S.invProducts);
  sel.innerHTML = '<option value="">-- পণ্য নির্বাচন করুন --</option>' + products.map(function(p){
    return '<option value="' + p.id + '">' + esc(p.name) + ' (স্টক: ' + bn(p.stock || 0) + ')</option>';
  }).join('');
  invFillPrice();
}
function invFillPrice(){
  var id = Number(document.getElementById('invProduct').value) || 0;
  var p = arr(S.invProducts).find(function(x){ return x.id === id; });
  document.getElementById('invPrice').value = p ? (p.sellPrice || 0) : 0;
  invCalc();
}
function invCalc(){
  var qty = Number(document.getElementById('invQty').value) || 0;
  var price = Number(document.getElementById('invPrice').value) || 0;
  document.getElementById('invTotal').value = (qty * price).toFixed(2);
}
function renderInvStock(){
  var products = arr(S.invProducts);
  document.getElementById('invStockBody').innerHTML = products.length ? products.map(function(p, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(p.name) + '</td><td>' + esc(p.type || '-') + '</td><td>' + esc(p.unit || '-') +
      '</td><td>' + bn(p.sellPrice || 0) + '</td><td>' + bn(p.stock || 0) + '</td></tr>';
  }).join('') : '<tr><td colspan="6" class="empty-row">কোনো পণ্য নেই</td></tr>';
}
function renderInvSales(){
  var sales = arr(S.invSales).slice().reverse().slice(0, 30);
  document.getElementById('invSaleBody').innerHTML = sales.length ? sales.map(function(s, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(s.date || '') + '</td><td>' + esc(s.customer || '-') + '</td><td>' + bn(s.net || 0) +
      '</td><td>' + bn(s.paid || 0) + '</td><td>' + bn(s.due || 0) + '</td></tr>';
  }).join('') : '<tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr>';
}
function saveInvSale(){
  var pid = Number(document.getElementById('invProduct').value) || 0;
  var products = arr(S.invProducts).slice();
  var p = products.find(function(x){ return x.id === pid; });
  if(!p){ toast('পণ্য নির্বাচন করুন'); return; }
  var qty = Number(document.getElementById('invQty').value) || 0;
  if(qty <= 0){ toast('পরিমাণ দিন'); return; }
  var price = Number(document.getElementById('invPrice').value) || 0;
  var total = qty * price;
  var paid = Number(document.getElementById('invPaid').value) || 0;
  var due = Math.max(0, total - paid);
  var sales = arr(S.invSales).slice();
  var iso = todayISO();
  sales.push({
    id: nextId(sales), dateISO: iso, date: bnDate(iso),
    customer: document.getElementById('invCustomer').value.trim() || 'নগদ গ্রাহক',
    items: [{ productId: p.id, name: p.name, qty: qty, price: price, total: total }],
    total: total, discount: 0, net: total, paid: paid, due: due,
    status: due > 0 ? 'বাকি' : 'পরিশোধিত', by: userName()
  });
  p.stock = Math.max(0, (Number(p.stock) || 0) - qty);

  saveKeys({ invSales: sales, invProducts: products }).then(function(){
    toast('বিক্রয় সংরক্ষণ করা হয়েছে!');
    document.getElementById('invQty').value = 1;
    document.getElementById('invPaid').value = 0;
    document.getElementById('invCustomer').value = '';
    invFillProducts(); renderInvStock(); renderInvSales();
  });
}

/* ══════════ ৫. পড়া দেওয়া ══════════ */
function subjectsForClass(cls){
  var names = {};
  arr(S.subjects).forEach(function(s){ if(!cls || !arr(s.classes).length || s.classes.indexOf(cls) !== -1) names[s.name]=1; });
  arr(S.examSubjects).forEach(function(s){ if(!cls || !arr(s.classes).length || s.classes.indexOf(cls) !== -1) names[s.name]=1; });
  var out = Object.keys(names);
  return out.length ? out : ['কুরআন', 'বাংলা', 'গণিত', 'ইংরেজি'];
}
function fillHwSubjects(){
  var sel = document.getElementById('hwSubject'); if(!sel) return;
  sel.innerHTML = subjectsForClass(document.getElementById('hwClass').value).map(function(s){
    return '<option>' + esc(s) + '</option>';
  }).join('');
}
function renderHomework(){
  var list = arr(S.hwDailyList).slice().reverse();
  document.getElementById('hwBody').innerHTML = list.length ? list.map(function(h, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(h.cls || '-') + '</td><td>' + esc(h.subject || '-') + '</td><td>' + esc(h.task || '') +
      '</td><td>' + esc(h.date || '') + '</td><td>' + esc(h.teacher || '-') +
      '</td><td><button class="btn red" style="padding:5px 10px;font-size:12.5px;" onclick="deleteHomework(' + h.id + ')">মুছুন</button></td></tr>';
  }).join('') : '<tr><td colspan="7" class="empty-row">কোনো তথ্য নেই</td></tr>';
}
function saveHomework(){
  var cls = document.getElementById('hwClass').value;
  var subject = document.getElementById('hwSubject').value;
  var task = document.getElementById('hwTask').value.trim();
  var date = document.getElementById('hwDate').value;
  if(!cls || !subject || !task || !date){ toast('শ্রেণী, বিষয়, বিবরণ ও তারিখ আবশ্যক'); return; }
  var list = arr(S.hwDailyList).slice();
  list.push({
    id: nextId(list), cls: cls, subject: subject, task: task,
    khata: document.getElementById('hwKhata').checked,
    date: bnDate(date), dateISO: date, ts: Date.now(), teacher: userName(), status: 'সম্পন্ন'
  });
  saveKeys({ hwDailyList: list }).then(function(){
    toast('পড়া সংরক্ষণ করা হয়েছে!');
    document.getElementById('hwTask').value = '';
    document.getElementById('hwKhata').checked = false;
    renderHomework();
  });
}
function deleteHomework(id){
  if(!confirm('এই পড়াটি মুছে ফেলবেন?')) return;
  var list = arr(S.hwDailyList).filter(function(h){ return h.id !== id; });
  saveKeys({ hwDailyList: list }).then(function(){ toast('মুছে ফেলা হয়েছে'); renderHomework(); });
}

/* ══════════ ৬. ক্লাস হাজিরার নোটিশ ══════════ */
function attNotices(){ return arr(S.notices).filter(function(n){ return n.kind === 'attendance'; }); }
function renderAttNotices(){
  var list = attNotices().slice().reverse();
  document.getElementById('anBody').innerHTML = list.length ? list.map(function(n, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(n.title) + '</td><td>' + esc(n.desc || '') + '</td><td>' + esc(arr(n.classes).join(', ') || 'সব') +
      '</td><td>' + esc(n.start || '') + '</td><td><button class="btn red" style="padding:5px 10px;font-size:12.5px;" onclick="deleteAttNotice(' + n.id + ')">মুছুন</button></td></tr>';
  }).join('') : '<tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr>';
}
function saveAttNotice(){
  var title = document.getElementById('anTitle').value.trim();
  var desc = document.getElementById('anDesc').value.trim();
  if(!title || !desc){ toast('শিরোনাম ও বিবরণ আবশ্যক'); return; }
  var notices = arr(S.notices).slice();
  var date = document.getElementById('anDate').value || todayISO();
  notices.push({
    id: nextId(notices), kind: 'attendance', title: title, desc: desc,
    start: date, end: date, status: 'সক্রিয়',
    classes: checkedValues('anClassChk'), divisions: [], by: userName()
  });
  saveKeys({ notices: notices }).then(function(){
    toast('নোটিশ প্রকাশ করা হয়েছে!');
    document.getElementById('anTitle').value = '';
    document.getElementById('anDesc').value = '';
    document.querySelectorAll('.anClassChk').forEach(function(c){ c.checked = false; });
    renderAttNotices();
  });
}
function deleteAttNotice(id){
  if(!confirm('নোটিশটি মুছে ফেলবেন?')) return;
  var notices = arr(S.notices).filter(function(n){ return n.id !== id; });
  saveKeys({ notices: notices }).then(function(){ toast('মুছে ফেলা হয়েছে'); renderAttNotices(); });
}

/* ══════════ ৭. বিষয় ══════════ */
function renderSubjects(){
  var list = arr(S.subjects);
  document.getElementById('sbBody').innerHTML = list.length ? list.map(function(s, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(s.name) + '</td><td>' + esc(arr(s.classes).join(', ') || '-') +
      '</td><td><button class="btn red" style="padding:5px 10px;font-size:12.5px;" onclick="deleteSubject(' + s.id + ')">মুছুন</button></td></tr>';
  }).join('') : '<tr><td colspan="4" class="empty-row">কোনো বিষয় নেই</td></tr>';
}
function saveSubject(){
  var name = document.getElementById('sbName').value.trim();
  if(!name){ toast('বিষয়ের নাম দিন'); return; }
  var list = arr(S.subjects).slice();
  list.push({ id: nextId(list), name: name, classes: checkedValues('sbClassChk') });
  saveKeys({ subjects: list }).then(function(){
    toast('বিষয় সংরক্ষণ করা হয়েছে!');
    document.getElementById('sbName').value = '';
    document.querySelectorAll('.sbClassChk').forEach(function(c){ c.checked = false; });
    renderSubjects();
  });
}
function deleteSubject(id){
  if(!confirm('বিষয়টি মুছে ফেলবেন?')) return;
  var list = arr(S.subjects).filter(function(s){ return s.id !== id; });
  saveKeys({ subjects: list }).then(function(){ toast('মুছে ফেলা হয়েছে'); renderSubjects(); });
}

/* ══════════ ৮. পরিক্ষার বিষয় ══════════ */
function renderExamSubjects(){
  var list = arr(S.examSubjects);
  document.getElementById('esBody').innerHTML = list.length ? list.map(function(s, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(s.name) + '</td><td>' + esc(arr(s.classes).join(', ') || '-') +
      '</td><td><button class="btn red" style="padding:5px 10px;font-size:12.5px;" onclick="deleteExamSubject(' + s.id + ')">মুছুন</button></td></tr>';
  }).join('') : '<tr><td colspan="4" class="empty-row">কোনো বিষয় নেই</td></tr>';
}
function saveExamSubject(){
  var name = document.getElementById('esName').value.trim();
  if(!name){ toast('বিষয়ের নাম দিন'); return; }
  var list = arr(S.examSubjects).slice();
  list.push({ id: nextId(list), name: name, classes: checkedValues('esClassChk') });
  saveKeys({ examSubjects: list }).then(function(){
    toast('পরিক্ষার বিষয় সংরক্ষণ করা হয়েছে!');
    document.getElementById('esName').value = '';
    document.querySelectorAll('.esClassChk').forEach(function(c){ c.checked = false; });
    renderExamSubjects();
  });
}
function deleteExamSubject(id){
  if(!confirm('বিষয়টি মুছে ফেলবেন?')) return;
  var list = arr(S.examSubjects).filter(function(s){ return s.id !== id; });
  saveKeys({ examSubjects: list }).then(function(){ toast('মুছে ফেলা হয়েছে'); renderExamSubjects(); });
}

/* ══════════ ৯. ফি আদায় ══════════ */
function renderFeeStudents(){
  var sel = document.getElementById('feeStudent');
  var cur = sel.value;
  sel.innerHTML = '<option value="">-- শিক্ষার্থী নির্বাচন করুন --</option>' + arr(S.students).map(function(st){
    return '<option value="' + st.id + '">' + esc(st.name) + ' (' + esc(st.cls || '') + ')</option>';
  }).join('');
  if(cur) sel.value = cur;
  renderFeeDues();
}
function renderFeeDues(){
  feeSelected = {};
  var id = parseInt(document.getElementById('feeStudent').value) || 0;
  var dues = arr(obj(S.studentDues)[id]);
  document.getElementById('feeDueList').innerHTML = dues.length ? dues.map(function(d){
    return '<label style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding:10px 4px;font-size:14px;">' +
      '<span><input type="checkbox" onchange="toggleDue(' + d.id + ', ' + (Number(d.amount)||0) + ', this.checked)"> ' + esc(d.label) +
      ' <small style="color:var(--muted)">' + esc(d.month || '') + '</small></span><strong>' + bn(d.amount) + ' টাকা</strong></label>';
  }).join('') : '<div class="empty-row">কোনো বকেয়া নেই</div>';
  var total = dues.reduce(function(sum,d){ return sum + (Number(d.amount)||0); }, 0);
  document.getElementById('feeTotalDue').textContent = total.toFixed(2);
  document.getElementById('feePaid').value = 0;
  document.getElementById('feeDiscount').value = 0;
  updateFeeSummary();
}
function toggleDue(id, amount, on){
  if(on) feeSelected[id] = amount; else delete feeSelected[id];
  var sum = Object.keys(feeSelected).reduce(function(t,k){ return t + Number(feeSelected[k]); }, 0);
  document.getElementById('feePaid').value = sum;
  updateFeeSummary();
}
function updateFeeSummary(){
  var sum = Object.keys(feeSelected).reduce(function(t,k){ return t + Number(feeSelected[k]); }, 0);
  var discount = Number(document.getElementById('feeDiscount').value) || 0;
  var paid = Number(document.getElementById('feePaid').value) || 0;
  document.getElementById('feeSelected').textContent = sum.toFixed(2) + ' টাকা';
  document.getElementById('feeRemaining').textContent = Math.max(0, sum - discount - paid).toFixed(2) + ' টাকা';
}
function renderFeePayments(){
  var pays = arr(S.payments).slice().reverse().slice(0, 20);
  document.getElementById('feePayBody').innerHTML = pays.length ? pays.map(function(p, i){
    return '<tr><td>' + bn(i+1) + '</td><td>' + esc(p.student || '-') + '</td><td>' + bn(p.amount || 0) + '</td><td>' + esc(p.month || '-') +
      '</td><td>' + esc(p.date || '') + '</td><td>' + esc(p.by || '-') + '</td></tr>';
  }).join('') : '<tr><td colspan="6" class="empty-row">কোনো তথ্য নেই</td></tr>';
}
function saveFeeCollection(){
  var id = parseInt(document.getElementById('feeStudent').value) || 0;
  var student = arr(S.students).find(function(st){ return st.id === id; });
  if(!student){ toast('শিক্ষার্থী নির্বাচন করুন'); return; }
  var paid = Number(document.getElementById('feePaid').value) || 0;
  if(paid <= 0){ toast('পরিশোধের পরিমাণ দিন'); return; }

  var dues = obj(S.studentDues);
  var mine = arr(dues[id]);
  var selectedIds = Object.keys(feeSelected).map(Number);
  var collected = mine.filter(function(d){ return selectedIds.indexOf(d.id) !== -1; });

  var payments = arr(S.payments).slice();
  var paymentDetails = arr(S.paymentDetails).slice();
  var iso = todayISO();
  var today = bnDate(iso);
  var billBase = paymentDetails.length ? (Number(paymentDetails[paymentDetails.length-1].billNo) || 100) + 1 : 100;
  var method = document.getElementById('feeMethod').value;
  var remark = document.getElementById('feeRemark').value || 'শিক্ষক প্যানেল থেকে আদায়';

  payments.push({
    id: nextId(payments), studentId: id, student: student.name, regNo: student.regNo,
    cls: student.cls || '', amount: paid, month: (collected[0] && collected[0].month) || monthLabel(),
    date: today, dateISO: iso, by: userName(), method: method, billNo: billBase, remark: remark
  });
  var rows = collected.length ? collected : [{ label: 'অগ্রিম ফি', amount: paid, month: monthLabel() }];
  rows.forEach(function(d, i){
    paymentDetails.push({
      id: nextId(paymentDetails) + i, billNo: billBase + i, studentId: id, studentName: student.name,
      date: today, dateISO: iso, label: d.label, amount: d.amount,
      month: d.month || monthLabel(), method: method, by: userName(), remark: remark
    });
  });
  dues[id] = mine.filter(function(d){ return selectedIds.indexOf(d.id) === -1; });

  saveKeys({ payments: payments, paymentDetails: paymentDetails, studentDues: dues }).then(function(){
    toast('ফি আদায় সংরক্ষণ করা হয়েছে!');
    document.getElementById('feeRemark').value = '';
    renderFeeDues();
    renderFeePayments();
  });
}

document.addEventListener('DOMContentLoaded', boot);
</script>
<script src="nq-en-digits.js"></script>
<script src="pwa-install.js"></script>
</body>
</html>
